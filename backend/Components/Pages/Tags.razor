@page "/panel/tags"

<PageTitle>Tags</PageTitle>

<h1>Tags</h1>

@if (Error is not null) {
  <p class="panel-error">@Error</p>
}

<section class="panel-section">
  <h2>Clean up orphan tags</h2>
  <p>Removes tags that are no longer associated with any audio.</p>
  <button @onclick="RunCleanup" disabled="@IsBusy">Clean up orphan tags</button>
  @if (CleanupResult is not null) {
    <p>Deleted @CleanupResult orphan tag(s).</p>
  }
</section>

<section class="panel-section">
  <h2>Merge tags</h2>
  <p>Moves every audio from one tag to another, then deletes the source tag.</p>

  <div class="panel-field">
    <label>Tag to remove</label>
    <select @bind="SourceTagValue">
      <option value="">Select a tag</option>
      @foreach (var tag in AllTags) {
        <option value="@tag.Id.ToString()">@tag.Name</option>
      }
    </select>
  </div>

  <div class="panel-field">
    <label>Tag to keep (replacement)</label>
    <select @bind="TargetTagValue">
      <option value="">Select a tag</option>
      @foreach (var tag in AllTags) {
        <option value="@tag.Id.ToString()">@tag.Name</option>
      }
    </select>
  </div>

  <button @onclick="RunMerge"
          disabled="@(IsBusy || string.IsNullOrEmpty(SourceTagValue) || string.IsNullOrEmpty(TargetTagValue))">
    Merge tags
  </button>

  @if (MergeResult is not null) {
    <p>Replaced on @MergeResult audio(s).</p>
  }
</section>

<section class="panel-section">
  <h2>Create tag</h2>

  <div class="panel-field">
    <label>Name</label>
    <input @bind="NewTagName" placeholder="Tag name" />
  </div>

  <div class="panel-field">
    <label>Description (optional)</label>
    <input @bind="NewTagDescription" placeholder="Description" />
  </div>

  <button @onclick="RunCreate" disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewTagName))">Add tag</button>

  @if (CreateResult is not null) {
    <p>Created tag "@CreateResult".</p>
  }
</section>

@code {
  [Inject] private ITagService TagService { get; set; } = default!;
  [Inject] private ICachingService Caching { get; set; } = default!;

  private List<Tag> AllTags { get; set; } = [];
  private string? SourceTagValue { get; set; }
  private string? TargetTagValue { get; set; }
  private string? NewTagName { get; set; }
  private string? NewTagDescription { get; set; }

  private bool IsBusy { get; set; }
  private int? CleanupResult { get; set; }
  private int? MergeResult { get; set; }
  private string? CreateResult { get; set; }
  private string? Error { get; set; }

  protected override async Task OnInitializedAsync() {
    await LoadTags();
  }

  private async Task LoadTags() {
    AllTags = await TagService.GetTags();
  }

  private async Task RunCleanup() {
    IsBusy = true;
    CleanupResult = null;
    Error = null;
    try {
      CleanupResult = await TagService.CleanupOrphanTags();
      await Caching.DeleteGroupAsync("tag");
      await LoadTags();
    } catch (Exception e) {
      Error = e.Message;
    } finally {
      IsBusy = false;
    }
  }

  private async Task RunMerge() {
    if (!Guid.TryParse(SourceTagValue, out var sourceId) ||
        !Guid.TryParse(TargetTagValue, out var targetId)) {
      return;
    }

    IsBusy = true;
    MergeResult = null;
    Error = null;
    try {
      MergeResult = await TagService.MergeTags(sourceId, targetId);
      await Caching.DeleteGroupAsync("tag");
      await Caching.DeleteGroupAsync("audio");
      SourceTagValue = null;
      TargetTagValue = null;
      await LoadTags();
    } catch (Exception e) {
      Error = e.Message;
    } finally {
      IsBusy = false;
    }
  }

  private async Task RunCreate() {
    if (string.IsNullOrWhiteSpace(NewTagName)) return;

    IsBusy = true;
    CreateResult = null;
    Error = null;
    try {
      var tag = await TagService.CreateTag(NewTagName, NewTagDescription);
      CreateResult = tag.Name;
      await Caching.DeleteGroupAsync("tag");
      NewTagName = null;
      NewTagDescription = null;
      await LoadTags();
    } catch (Exception e) {
      Error = e.Message;
    } finally {
      IsBusy = false;
    }
  }
}
